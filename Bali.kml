    <Folder>
      <name>Livello senza titolo</name>
      <Placemark>
        <name>KU DE TA</name>
        <description>Beautiful place on the beach for a great aperitif at sunset, good music and nice people. For dinner it is advisable to go up one floor at the MEJEKAWI restaurant</description>
        <styleUrl>#icon-1517-0288D1</styleUrl>
        <Point>
          <coordinates>
            115.1547554,-8.6870993,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>La Plancha</name>
        <description>Great aperitif at sunset, beautiful music and lots of nice people</description>
        <styleUrl>#icon-1521-0288D1</styleUrl>
        <Point>
          <coordinates>
            115.1597703,-8.6944351,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>La Favela Bali</name>
        <description>Unmissable venue to see for its structure and its bizarre decor. Great for a drink after dinner</description>
        <styleUrl>#icon-1517-0288D1</styleUrl>
        <Point>
          <coordinates>
            115.1628709,-8.6839514,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>Potato Head Beach Club</name>
